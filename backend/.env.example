# Server
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
# Comma-separated origins. Add your exact deployed Vercel URL in production.
CORS_ORIGIN=http://localhost:3000
SERVER_URL=http://localhost:8000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/projectflow

# Use long, random, different secrets for access and refresh tokens.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
REFRESH_TOKEN_EXPIRY=7d

# Link sent from forgot-password email. This route exists in the Next.js frontend.
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password

# SMTP (needed for email verification and password recovery in production)
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
MAIL_FROM=ProjectFlow <no-reply@example.com>
